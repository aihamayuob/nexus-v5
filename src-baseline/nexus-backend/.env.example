# ============================================================================
# nexus-backend — environment configuration
# Copy to .env and fill in what you need. Nothing here is required to boot
# the server; it will start with zero providers configured and every
# provider-dependent route will return a clear validation/capability error
# until you add the relevant key(s) below.
# ============================================================================

# --- Server ---
NEXUS_PORT=8787
# Listen address. DEFAULT AND SAFEST: 127.0.0.1 (this machine only).
# To reach the backend from other devices on a trusted LAN, set it explicitly
# (0.0.0.0 = every interface, or this machine's LAN IP) AND set
# NEXUS_GATEWAY_KEYS below — the server REFUSES TO START on a non-loopback
# address without keys (there is no override). This release is for local /
# trusted-LAN use over plain HTTP; it is NOT suitable for the public internet.
NEXUS_HOST=127.0.0.1
NODE_ENV=production

# --- Gateway auth ---
# Comma-separated list of accepted Bearer tokens.
#  - REQUIRED whenever NEXUS_HOST is not a loopback address (LAN use):
#    each key >= 16 characters, no spaces, no duplicates. Generate one with:
#       node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#  - May stay EMPTY only while NEXUS_HOST=127.0.0.1 (trusted/no-auth, this
#    machine only).
# If you set even one key here, EVERY protected route requires a valid Bearer
# match — there is no partial/optional state. Never commit a real key.
NEXUS_GATEWAY_KEYS=

# --- Provider API keys (only set the ones you actually use) ---
NEXUS_ANTHROPIC_API_KEY=
NEXUS_OPENAI_API_KEY=
NEXUS_DEEPSEEK_API_KEY=
NEXUS_GEMINI_API_KEY=
# Ollama / LM Studio need no key — just make sure they're reachable at the
# base URLs below (defaults assume they're running on this same machine).
NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXUS_LMSTUDIO_BASE_URL=http://127.0.0.1:1234
NEXUS_MODEL_OLLAMA=
NEXUS_MODEL_LMSTUDIO=

# --- Model overrides (optional — sane defaults are baked into
#     src/config/providerRegistry.ts; override here instead of editing code
#     when a vendor ships a new model) ---
# NEXUS_MODEL_ANTHROPIC=claude-sonnet-4-6
# NEXUS_MODEL_OPENAI=gpt-4o
# NEXUS_MODEL_DEEPSEEK=deepseek-chat
# NEXUS_MODEL_GEMINI=gemini-2.0-flash

# --- Concurrency / timeouts / retries ---
NEXUS_MAX_CONCURRENCY=8
NEXUS_MAX_CONCURRENCY_PER_PLAN=4
NEXUS_TASK_TIMEOUT_MS=90000
NEXUS_PLAN_TIMEOUT_MS=600000
NEXUS_MAX_RETRIES=2
NEXUS_RETRY_BASE_DELAY_MS=500

# --- Budget guard (0 = disabled) ---
NEXUS_DAILY_BUDGET_USD=0

# --- Rate limiting ---
NEXUS_RATE_LIMIT_PER_MINUTE=60
NEXUS_RATE_LIMIT_BURST=20
# F06-a: TCP peers whose X-Forwarded-For is trusted (exact IPs / IPv4 CIDRs, comma-separated). EMPTY (default) = header ignored, socket address is the client identity.
# Set ONLY to your own reverse proxy's address (e.g. 127.0.0.1,::1 for a same-host proxy). Wildcards / "true" are not supported and are ignored (fail closed).
NEXUS_TRUST_PROXY=

# --- Payload / web_fetch limits ---
NEXUS_MAX_BODY_BYTES=2097152
NEXUS_WEB_FETCH_MAX_CHARS=12000
NEXUS_WEB_FETCH_TIMEOUT_MS=10000

# --- Storage ---
NEXUS_DB_PATH=./data/nexus.db

# --- CORS (only needed if the frontend is served from a different origin) ---
NEXUS_CORS_ORIGINS=

# --- Logging ---
NEXUS_LOG_LEVEL=info

# --- Retention sweeps (Phase 3) — how long operational data is kept before
#     an hourly background sweep prunes it. Audit log is kept far longer by
#     design (180 days) since its whole value is historical. ---
NEXUS_RETENTION_STREAM_EVENTS_MS=21600000
NEXUS_RETENTION_OBSERVABILITY_MS=2592000000
NEXUS_RETENTION_PROVIDER_LOG_MS=2592000000
NEXUS_RETENTION_AUDIT_MS=15552000000

# --- MCP server (POST /mcp, authenticated; ADR-006) ---
# Only 'pure' tools are exposed by default. Set to 1 to ALSO expose 'read_only' tools such as web_fetch (server-side network egress). Effectful (VEL) tools are never exposed.
NEXUS_MCP_EXPOSE_READ_ONLY=0
