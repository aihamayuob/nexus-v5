  <!-- React & Libraries -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/lucide-react@0.263.1/dist/umd/lucide-react.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    const { useState, useEffect, useRef, useCallback } = React;
    const { UserCog, Calculator, Scale, Users, TrendingUp, Megaphone, Lightbulb, Search, BarChart3, Shield, Target, GraduationCap, HeartPulse, Headphones, Bot, PanelLeftOpen, PanelLeftClose, Library, Settings, Send, Square, X, Plus, Trash2, Key, Globe } = lucideReact;

    const AGENTS = [
      { id: 'manager', name: 'الوكيل المدير', description: 'إدارة وتوجيه الوكلاء وصياغة القرارات الاستراتيجية', icon: UserCog, color: 'cyan', preferredProvider: 'anthropic', preferredModel: 'claude-3-5-sonnet-20241022', providerLabel: 'Claude Sonnet' },
      { id: 'accountant', name: 'المحاسب', description: 'التحليل المالي والحسابات الدقيقة وإعداد التقارير', icon: Calculator, color: 'green', preferredProvider: 'openai', preferredModel: 'gpt-4o', providerLabel: 'GPT-4o' },
      { id: 'legal', name: 'القانوني', description: 'الاستشارات القانونية وصياغة العقود وتحليل المخاطر', icon: Scale, color: 'orange', preferredProvider: 'anthropic', preferredModel: 'claude-3-5-sonnet-20241022', providerLabel: 'Claude Sonnet' },
      { id: 'hr', name: 'الموارد البشرية', description: 'إدارة شؤون الموظفين والتوظيف وتطوير بيئة العمل', icon: Users, color: 'purple', preferredProvider: 'openai', preferredModel: 'gpt-4o', providerLabel: 'GPT-4o' },
      { id: 'investor', name: 'المستثمر', description: 'تحليل الاستثمارات والأسواق المالية وتقييم المخاطر', icon: TrendingUp, color: 'cyan', preferredProvider: 'anthropic', preferredModel: 'claude-3-5-sonnet-20241022', providerLabel: 'Claude Sonnet' },
      { id: 'marketing', name: 'التسويق', description: 'استراتيجيات التسويق الرقمي والمبيعات وبناء العلامة', icon: Megaphone, color: 'red', preferredProvider: 'openai', preferredModel: 'gpt-4o', providerLabel: 'GPT-4o' },
      { id: 'innovator', name: 'المبتكر', description: 'توليد الأفكار الإبداعية والابتكار وحل المشكلات', icon: Lightbulb, color: 'orange', preferredProvider: 'google', preferredModel: 'gemini-1.5-pro', providerLabel: 'Gemini Pro' },
      { id: 'researcher', name: 'الباحث', description: 'البحث العلمي المعمق وجمع البيانات وتحليل المصادر', icon: Search, color: 'cyan', preferredProvider: 'anthropic', preferredModel: 'claude-3-5-sonnet-20241022', providerLabel: 'Claude Sonnet' },
      { id: 'data_analyst', name: 'محلل البيانات', description: 'تحليل البيانات المعقدة واستخراج الأنماط والنماذج', icon: BarChart3, color: 'purple', preferredProvider: 'openai', preferredModel: 'gpt-4o', providerLabel: 'GPT-4o' },
      { id: 'security', name: 'الأمن', description: 'الأمن السيبراني وتحليل المخاطر الرقمية وحماية النظم', icon: Shield, color: 'red', preferredProvider: 'anthropic', preferredModel: 'claude-3-5-sonnet-20241022', providerLabel: 'Claude Sonnet' },
      { id: 'strategy', name: 'الاستراتيجية', description: 'التخطيط الاستراتيجي للأعمال وتحليل السوق والمنافسين', icon: Target, color: 'green', preferredProvider: 'anthropic', preferredModel: 'claude-3-5-sonnet-20241022', providerLabel: 'Claude Sonnet' },
      { id: 'education', name: 'التعليم', description: 'التطوير المهني والتدريب وتصميم المناهج التعليمية', icon: GraduationCap, color: 'orange', preferredProvider: 'openai', preferredModel: 'gpt-4o', providerLabel: 'GPT-4o' },
      { id: 'health', name: 'الصحة', description: 'الاستشارات الصحية والطبية العامة ومتابعة الصحة', icon: HeartPulse, color: 'red', preferredProvider: 'anthropic', preferredModel: 'claude-3-5-sonnet-20241022', providerLabel: 'Claude Sonnet' },
      { id: 'support', name: 'خدمة العملاء', description: 'دعم العملاء وحل المشكلات وتحسين تجربة المستخدم', icon: Headphones, color: 'cyan', preferredProvider: 'openai', preferredModel: 'gpt-4o-mini', providerLabel: 'GPT-4o Mini' },
    ];

    // ---------- Knowledge Base Helper (localStorage) ----------
    function getKnowledgeBase() {
      try { return JSON.parse(localStorage.getItem('nexus_kb') || '[]'); } catch { return []; }
    }
    function saveKnowledgeBase(items) {
      localStorage.setItem('nexus_kb', JSON.stringify(items));
    }
    function addKnowledge(title, content, agentId = null) {
      const items = getKnowledgeBase();
      const newItem = { id: Date.now(), title, content, agentId, created_at: new Date().toISOString() };
      items.unshift(newItem);
      saveKnowledgeBase(items);
      return newItem;
    }
    function deleteKnowledge(id) {
      const items = getKnowledgeBase().filter(i => i.id !== id);
      saveKnowledgeBase(items);
    }

    // ---------- Conversation Helper (localStorage) ----------
    function getConversations() {
      try { return JSON.parse(localStorage.getItem('nexus_conv') || '[]'); } catch { return []; }
    }
    function saveConversation(conv) {
      const convs = getConversations();
      convs.unshift(conv);
      localStorage.setItem('nexus_conv', JSON.stringify(convs));
    }

    // ---------- API Keys Helper ----------
    function getApiKeys() {
      try { return JSON.parse(localStorage.getItem('nexus_keys') || '{}'); } catch { return {}; }
    }
    function setApiKeys(keys) {
      localStorage.setItem('nexus_keys', JSON.stringify(keys));
    }

    // ---------- Streaming Fetchers ----------
    async function streamAnthropic(apiKey, model, system, messages, onChunk, onError, signal) {
      try {
        const res = await fetch('https://api.anthropic.com/v1/messages', {
          method: 'POST',
          headers: { 'x-api-key': apiKey, 'anthropic-version': '2023-06-01', 'Content-Type': 'application/json' },
          body: JSON.stringify({ model, max_tokens: 4096, system, messages: messages.map(m => ({ role: m.role === 'assistant' ? 'assistant' : 'user', content: m.content })), stream: true }),
          signal
        });
        if (!res.ok) throw new Error(`Anthropic Error ${res.status}: ${await res.text()}`);
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() || '';
          for (const line of lines) {
            if (line.startsWith('data: ')) {
              const data = line.slice(6);
              try {
                const parsed = JSON.parse(data);
                if (parsed.type === 'content_block_delta' && parsed.delta?.text) {
                  onChunk(parsed.delta.text);
                }
              } catch (e) {}
            }
          }
        }
      } catch (e) {
        if (e.name !== 'AbortError') onError(e.message);
      }
    }

    async function streamOpenAI(apiKey, model, system, messages, onChunk, onError, signal) {
      try {
        const res = await fetch('https://api.openai.com/v1/chat/completions', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ model, stream: true, messages: [{ role: 'system', content: system }, ...messages.map(m => ({ role: m.role, content: m.content }))] }),
          signal
        });
        if (!res.ok) throw new Error(`OpenAI Error ${res.status}: ${await res.text()}`);
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() || '';
          for (const line of lines) {
            if (line.startsWith('data: ')) {
              const data = line.slice(6);
              if (data === '[DONE]') continue;
              try {
                const parsed = JSON.parse(data);
                if (parsed.choices?.[0]?.delta?.content) {
                  onChunk(parsed.choices[0].delta.content);
                }
              } catch (e) {}
            }
          }
        }
      } catch (e) {
        if (e.name !== 'AbortError') onError(e.message);
      }
    }

    async function streamGemini(apiKey, model, system, messages, onChunk, onError, signal) {
      try {
        const url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:streamGenerateContent?key=${apiKey}&alt=sse`;
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            system_instruction: { parts: [{ text: system }] },
            contents: messages.map(m => ({ role: m.role === 'assistant' ? 'model' : 'user', parts: [{ text: m.content }] })),
          }),
          signal
        });
        if (!res.ok) throw new Error(`Gemini Error ${res.status}: ${await res.text()}`);
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() || '';
          for (const line of lines) {
            if (line.startsWith('data: ')) {
              try {
                const parsed = JSON.parse(line.slice(6));
                const text = parsed.candidates?.[0]?.content?.parts?.[0]?.text;
                if (text) onChunk(text);
              } catch (e) {}
            }
          }
        }
      } catch (e) {
        if (e.name !== 'AbortError') onError(e.message);
      }
    }

    // ---------- Main App Component ----------
    function App() {
      const [selectedAgent, setSelectedAgent] = useState(AGENTS[0]);
      const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
      const [messages, setMessages] = useState([]);
      const [input, setInput] = useState('');
      const [streaming, setStreaming] = useState(false);
      const [abortController, setAbortController] = useState(null);
      const [selectedKnowledgeIds, setSelectedKnowledgeIds] = useState([]);
      const [showSettings, setShowSettings] = useState(false);
      const [showKnowledge, setShowKnowledge] = useState(false);
      const [apiKeys, setApiKeysState] = useState(getApiKeys());
      const messagesEndRef = useRef(null);

      useEffect(() => {
        messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
      }, [messages]);

      const currentKey = apiKeys[selectedAgent.preferredProvider] || '';

      const getSystemPrompt = (agent) => {
        return `أنت ${agent.name}. ${agent.description}. أجب باللغة العربية الفصحى، بشكل مختصر ومفيد.`;
      };

      const handleSend = useCallback(async (prompt) => {
        if (!prompt.trim() || streaming) return;
        const userMsg = { role: 'user', content: prompt };
        const assistantMsg = { role: 'assistant', content: '' };
        const newMessages = [...messages, userMsg, assistantMsg];
        setMessages(newMessages);
        setInput('');
        setStreaming(true);
        const controller = new AbortController();
        setAbortController(controller);

        // دمج المعرفة المحددة في systemPrompt
        let system = getSystemPrompt(selectedAgent);
        if (selectedKnowledgeIds.length > 0) {
          const allKnowledge = getKnowledgeBase();
          const selectedDocs = allKnowledge.filter(k => selectedKnowledgeIds.includes(k.id));
          if (selectedDocs.length > 0) {
            const ctx = selectedDocs.map(d => `### ${d.title}\n${d.content}`).join('\n\n---\n\n');
            system += `\n\n[قاعدة معرفية مرفقة]\n${ctx}`;
          }
        }

        const messagesForAPI = [...messages, userMsg]; // بدون رسالة المساعد الفارغة

        const onChunk = (text) => {
          setMessages(prev => {
            const updated = [...prev];
            const last = updated[updated.length - 1];
            if (last.role === 'assistant') {
              updated[updated.length - 1] = { ...last, content: last.content + text };
            }
            return updated;
          });
        };

        const onError = (errorMsg) => {
          setMessages(prev => {
            const updated = [...prev];
            const last = updated[updated.length - 1];
            if (last.role === 'assistant') {
              updated[updated.length - 1] = { ...last, content: last.content || `❌ خطأ: ${errorMsg}` };
            }
            return updated;
          });
          setStreaming(false);
        };

        const finish = () => {
          setStreaming(false);
          setAbortController(null);
          // حفظ المحادثة
          saveConversation({
            agentId: selectedAgent.id,
            agentName: selectedAgent.name,
            messages: JSON.stringify(newMessages),
            messageCount: newMessages.length,
            knowledgeIds: selectedKnowledgeIds,
            created_at: new Date().toISOString()
          });
        };

        try {
          if (selectedAgent.preferredProvider === 'openai') {
            await streamOpenAI(currentKey, selectedAgent.preferredModel, system, messagesForAPI, onChunk, onError, controller.signal);
          } else if (selectedAgent.preferredProvider === 'anthropic') {
            await streamAnthropic(currentKey, selectedAgent.preferredModel, system, messagesForAPI, onChunk, onError, controller.signal);
          } else if (selectedAgent.preferredProvider === 'google') {
            await streamGemini(currentKey, selectedAgent.preferredModel, system, messagesForAPI, onChunk, onError, controller.signal);
          }
        } catch (e) {
          onError(e.message);
        } finally {
          finish();
        }
      }, [messages, selectedAgent, currentKey, selectedKnowledgeIds, streaming]);

      const stopStream = () => {
        abortController?.abort();
      };

      const clearChat = () => setMessages([]);

      const persistKeys = (newKeys) => {
        setApiKeysState(newKeys);
        setApiKeys(newKeys);
      };

      return (
        <div className="flex h-screen overflow-hidden">
          {/* Sidebar */}
          <aside className={`card flex flex-col transition-all duration-300 ${sidebarCollapsed ? 'w-16' : 'w-64'}`}>
            <div className="p-4 flex items-center justify-between border-b border-slate-700">
              {!sidebarCollapsed && <h1 className="text-lg font-bold text-cyan-400">Nexus Agents</h1>}
              <button onClick={() => setSidebarCollapsed(!sidebarCollapsed)} className="p-1 hover:bg-white/10 rounded">
                {sidebarCollapsed ? <PanelLeftOpen size={20} /> : <PanelLeftClose size={20} />}
              </button>
            </div>
            <nav className="flex-1 overflow-y-auto p-2 space-y-1 scrollbar-thin">
              {AGENTS.map(agent => {
                const Icon = agent.icon || Bot;
                const active = selectedAgent.id === agent.id;
                return (
                  <button key={agent.id} onClick={() => { setSelectedAgent(agent); setMessages([]); }}
                    className={`w-full flex items-center gap-3 p-2 rounded-lg transition-all ${active ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' : 'hover:bg-white/5 text-gray-300'}`}>
                    <Icon size={20} className="shrink-0" />
                    {!sidebarCollapsed && (
                      <div className="text-right flex-1 overflow-hidden">
                        <div className="text-sm font-medium truncate">{agent.name}</div>
                        <div className="text-xs text-gray-500 truncate">{agent.description}</div>
                      </div>
                    )}
                  </button>
                );
              })}
            </nav>
          </aside>

          {/* Main Chat Area */}
          <main className="flex-1 flex flex-col min-w-0">
            {/* Header */}
            <header className="border-b border-slate-700 p-3 flex items-center justify-between card">
              <div className="flex items-center gap-3">
                <div className="text-cyan-400">{React.createElement(selectedAgent.icon || Bot, { size: 24 })}</div>
                <div>
                  <h2 className="font-bold">{selectedAgent.name}</h2>
                  <span className="text-xs text-gray-400">{selectedAgent.providerLabel}</span>
                </div>
              </div>
              <div className="flex gap-2 items-center">
                {messages.length > 0 && <button onClick={clearChat} className="text-xs text-gray-400 hover:text-white mr-2">جديد</button>}
                <button onClick={() => setShowKnowledge(true)} className="p-2 hover:bg-white/10 rounded relative" title="قاعدة المعرفة">
                  <Library size={20} />
                  {selectedKnowledgeIds.length > 0 && <span className="absolute -top-1 -right-1 bg-cyan-500 text-black text-xs rounded-full w-4 h-4 flex items-center justify-center">{selectedKnowledgeIds.length}</span>}
                </button>
                <button onClick={() => setShowSettings(true)} className="p-2 hover:bg-white/10 rounded" title="الإعدادات">
                  <Settings size={20} />
                </button>
              </div>
            </header>

            {/* Messages */}
            <div className="flex-1 overflow-y-auto p-4 space-y-4 scrollbar-thin">
              {messages.length === 0 && (
                <div className="text-center text-gray-500 mt-20">
                  <Bot size={48} className="mx-auto mb-4 text-cyan-500/50" />
                  <p className="text-lg">مرحباً بك في Nexus Agents</p>
                  <p className="text-sm">اختر وكيلاً وابدأ المحادثة</p>
                </div>
              )}
              {messages.map((msg, i) => (
                <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                  <div className={`max-w-[80%] p-3 rounded-xl ${msg.role === 'user' ? 'bg-cyan-500/20 text-cyan-100' : 'bg-white/5 text-gray-200'}`}>
                    {msg.role === 'assistant' ? (
                      <div className="prose prose-invert max-w-none" dangerouslySetInnerHTML={{ __html: marked.parse(msg.content) }} />
                    ) : (
                      <p className="whitespace-pre-wrap">{msg.content}</p>
                    )}
                  </div>
                </div>
              ))}
              <div ref={messagesEndRef} />
            </div>

            {/* Input */}
            <div className="border-t border-slate-700 p-3 flex gap-2 items-end card">
              <textarea
                value={input}
                onChange={(e) => setInput(e.target.value)}
                onKeyDown={(e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSend(input); } }}
                placeholder="اكتب رسالتك..."
                rows={1}
                className="flex-1 bg-black/30 rounded-lg p-3 resize-none focus:outline-none focus:ring-1 focus:ring-cyan-500"
                dir="rtl"
              />
              {streaming ? (
                <button onClick={stopStream} className="p-3 bg-red-500/80 hover:bg-red-500 rounded-lg"><Square size={20} /></button>
              ) : (
                <button onClick={() => handleSend(input)} disabled={!input.trim()} className="p-3 bg-cyan-500/80 hover:bg-cyan-500 rounded-lg disabled:opacity-50"><Send size={20} /></button>
              )}
            </div>
          </main>

          {/* Settings Modal */}
          {showSettings && (
            <div className="fixed inset-0 bg-black/60 flex items-center justify-center z-50">
              <div className="card rounded-xl p-6 w-full max-w-md">
                <h3 className="text-xl font-bold mb-4 flex items-center gap-2"><Key className="text-cyan-400" /> مفاتيح API</h3>
                <p className="text-xs text-gray-400 mb-4">أدخل مفتاح واحد على الأقل لتفعيل المزوّد</p>
                {['openai', 'anthropic', 'google'].map(provider => (
                  <div key={provider} className="mb-3">
                    <label className="text-sm text-gray-300 capitalize">{provider} API Key</label>
                    <input
                      type="password"
                      value={apiKeys[provider] || ''}
                      onChange={e => persistKeys({ ...apiKeys, [provider]: e.target.value })}
                      placeholder={provider === 'openai' ? 'sk-...' : provider === 'anthropic' ? 'sk-ant-...' : 'AIza...'}
                      className="w-full mt-1 bg-black/30 border border-white/10 rounded-lg p-2 focus:ring-cyan-500"
                    />
                  </div>
                ))}
                <div className="flex justify-end gap-3 mt-6">
                  <button onClick={() => setShowSettings(false)} className="px-4 py-2 rounded-lg hover:bg-white/5">إلغاء</button>
                  <button onClick={() => setShowSettings(false)} className="px-4 py-2 bg-cyan-500/80 hover:bg-cyan-500 rounded-lg">تم</button>
                </div>
              </div>
            </div>
          )}

          {/* Knowledge Base Modal */}
          {showKnowledge && (
            <KnowledgeModal
              selectedIds={selectedKnowledgeIds}
              onSelectionChange={setSelectedKnowledgeIds}
              onClose={() => setShowKnowledge(false)}
            />
          )}
        </div>
      );
    }

    // Knowledge Modal Component
    function KnowledgeModal({ selectedIds, onSelectionChange, onClose }) {
      const [docs, setDocs] = useState(getKnowledgeBase());
      const [newTitle, setNewTitle] = useState('');
      const [newContent, setNewContent] = useState('');

      const refresh = () => setDocs(getKnowledgeBase());

      const handleAdd = (e) => {
        e.preventDefault();
        if (newTitle.trim() && newContent.trim()) {
          addKnowledge(newTitle, newContent);
          setNewTitle('');
          setNewContent('');
          refresh();
        }
      };

      const handleDelete = (id) => {
        deleteKnowledge(id);
        refresh();
        onSelectionChange(selectedIds.filter(i => i !== id));
      };

      const toggle = (id) => {
        if (selectedIds.includes(id)) {
          onSelectionChange(selectedIds.filter(i => i !== id));
        } else {
          onSelectionChange([...selectedIds, id]);
        }
      };

      return (
        <div className="fixed inset-0 bg-black/60 flex items-center justify-center z-50">
          <div className="card rounded-xl p-6 w-full max-w-2xl max-h-[80vh] flex flex-col">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-xl font-bold flex items-center gap-2"><Library className="text-cyan-400" /> قاعدة المعرفة</h3>
              <button onClick={onClose} className="p-1 hover:bg-white/10 rounded"><X size={20} /></button>
            </div>

            <form onSubmit={handleAdd} className="flex gap-3 mb-4">
              <input
                placeholder="عنوان المستند"
                value={newTitle}
                onChange={e => setNewTitle(e.target.value)}
                className="flex-1 bg-black/30 border border-white/10 rounded-lg p-2 focus:ring-cyan-500"
              />
              <button type="submit" className="px-4 bg-cyan-500/80 hover:bg-cyan-500 rounded-lg"><Plus size={18} /></button>
            </form>
            <textarea
              placeholder="محتوى المستند..."
              value={newContent}
              onChange={e => setNewContent(e.target.value)}
              rows={4}
              className="bg-black/30 border border-white/10 rounded-lg p-2 mb-4 resize-none focus:ring-cyan-500"
            />

            <div className="flex-1 overflow-y-auto space-y-2 scrollbar-thin">
              {docs.length === 0 && <p className="text-gray-500 text-center">لا توجد مستندات بعد</p>}
              {docs.map(doc => (
                <div key={doc.id} className={`flex items-center justify-between p-3 rounded-lg border ${selectedIds.includes(doc.id) ? 'border-cyan-500/50 bg-cyan-500/10' : 'border-white/5 hover:bg-white/5'}`}>
                  <div className="flex items-center gap-3 flex-1 min-w-0">
                    <input
                      type="checkbox"
                      checked={selectedIds.includes(doc.id)}
                      onChange={() => toggle(doc.id)}
                      className="shrink-0"
                    />
                    <span className="truncate font-medium">{doc.title}</span>
                  </div>
                  <button onClick={() => handleDelete(doc.id)} className="text-red-400 hover:text-red-300 p-1"><Trash2 size={16} /></button>
                </div>
              ))}
            </div>

            <p className="text-xs text-gray-500 mt-3">المستندات المحددة ستُضاف كسياق في المحادثة الحالية.</p>
          </div>
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>